{
  "name": "laratax",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "build": "NODE_ENV=production node --import remix/node-tsx scripts/exporta.ts",
    "test": "NODE_ENV=test node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "remix": "^3.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
